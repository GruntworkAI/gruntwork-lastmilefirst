#!/bin/bash
# Thin wrapper around the canonical scan-secrets scanner.
# No duplicated code: this just locates the plugin repo and execs its scripts.
set -euo pipefail

REPO="${LMF_REPO:-$HOME/workspace/repos/gruntwork-lastmilefirst}"
SCANNER="$REPO/plugins/lastmilefirst/skills/scan-secrets/scripts/scan_secrets.py"

if [[ ! -f "$SCANNER" ]]; then
  echo "scan-secrets: plugin repo not found at $REPO" >&2
  echo "Set LMF_REPO to the gruntwork-lastmilefirst checkout." >&2
  exit 1
fi

export PATH="$HOME/workspace/bin:$PATH"   # gitleaks lives here
exec python3 "$SCANNER" "$@"
